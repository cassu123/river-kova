{
  "robot_id": "kova-sim-01",
  "version": "1.0.0",
  "description": "River Kova simulated unit — full brain, zero hardware",

  "hardware": {
    "backend": "sim",
    "arm": {
      "type": "6-dof",
      "controller": "moveit",
      "max_payload": 2.5,
      "planning_group": "arm"
    },
    "drive": {
      "type": "differential",
      "max_speed": 1.2,
      "wheel_base_m": 0.35
    },
    "sensors": {
      "camera": "sim-camera",
      "lidar": "sim-lidar"
    },
    "pico_serial_port": "sim://world"
  },

  "simulation": {
    "start_battery_pct": 100.0,
    "battery_drain_idle_pct_per_min": 0.2,
    "battery_drain_moving_pct_per_min": 1.5,
    "battery_charge_pct_per_min": 10.0,
    "time_scale": 1.0
  },

  "safety": {
    "human_detection_radius": 1.0,
    "estop_enabled": true,
    "max_collision_force": 10.0,
    "watchdog_timeout_sec": 5.0,
    "estop_recovery_delay_sec": 3.0
  },

  "connectivity": {
    "enabled": false,
    "api_endpoint": "https://api.riversongai.com",
    "vpn_required": false,
    "api_timeout_sec": 10,
    "telemetry_push_interval_sec": 5.0,
    "stream_port": 8080,
    "fastapi_port": 8000
  },

  "navigation": {
    "map_resolution": 0.05,
    "map_update_interval": 0.5,
    "path_replan_interval": 1.0,
    "base_station": {
      "x": 0.0,
      "y": 0.0,
      "tolerance": 0.1
    }
  },

  "vision": {
    "fps": 30,
    "width": 1280,
    "height": 720,
    "detection_confidence": 0.65,
    "classification_confidence": 0.70,
    "mediapipe_model_complexity": 1,
    "enable_depth": false
  },

  "telemetry": {
    "influxdb_url": "http://localhost:8086",
    "influxdb_org": "river-kova",
    "influxdb_bucket": "kova-telemetry",
    "log_level": "INFO",
    "log_dir": "/tmp/river-kova-sim"
  },

  "autonomy": {
    "enabled": true,
    "tick_interval_sec": 5.0,
    "min_battery_pct": 30.0,
    "routines": [
      { "chore": "VACUUM", "room": "kitchen", "time": "09:00", "days": ["mon", "wed", "fri"], "priority": 4 },
      { "chore": "FEED_DOGS", "time": "07:30", "priority": 6 },
      { "chore": "FEED_DOGS", "time": "18:00", "priority": 6 }
    ],
    "llm": {
      "enabled": false,
      "cooldown_sec": 1800.0,
      "context_path": "/tmp/river-kova-sim/household_context.txt"
    }
  },

  "fleet": {
    "fleet_id": "sim-home",
    "assigned_rooms": ["kitchen", "living_room", "hallway", "bedroom", "bathroom"],
    "home_timezone": "America/New_York"
  },

  "capabilities": {
    "vacuum": true,
    "mop": true,
    "arm_manipulation": true,
    "fetch": true,
    "organize": true,
    "wipe_surface": true,
    "take_out_trash": true,
    "load_dishwasher": true,
    "unload_dishwasher": true,
    "laundry_transfer": true,
    "get_water": true,
    "feed_dogs": true
  }
}
